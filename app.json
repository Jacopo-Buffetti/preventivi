{
  "expo": {
    "name": "Previo",
    "slug": "preventivi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "preventivi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.jacopobuffetti.preventivi",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.jacopobuffetti.preventivi",
      "adaptiveIcon": {
        "backgroundColor": "#02102B",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#02102B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240
        }
      ],
      "expo-sqlite",
      "expo-mail-composer",
      [
        "expo-image-picker",
        {
          "photosPermission": "Serve per scegliere la foto del preventivo firmato, della firma, del timbro o del logo del biglietto da visita.",
          "cameraPermission": "Serve per fotografare il preventivo firmato dal cliente.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9830893b-51f2-4c0d-a7b4-6961498a2e12"
      }
    }
  }
}
